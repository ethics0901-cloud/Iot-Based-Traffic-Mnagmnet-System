# ==============================================================================
# Supabase Environment Configuration
# ==============================================================================
# The Project URL and Publishable (anon) API Key from your Supabase Dashboard.
# NOTE: Never put your service_role / secret key in client-facing environments!

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# If using Vite or Next.js, use the framework-specific prefixes below:
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
